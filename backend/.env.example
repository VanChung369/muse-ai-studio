# Optional. Defaults work without creating a .env file.
MUSE_APP_NAME="Muse AI Studio"
# Relative paths resolve from the repository root, not the working directory.
MUSE_DATA_DIR=data
MUSE_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
# Re-check each enabled, verified account this often (minutes); 0 turns it off.
MUSE_SESSION_REFRESH_MINUTES=360
# Also wake the workspace on each refresh (the "Keep alive" action).
MUSE_SESSION_REFRESH_WAKE=false

# Seconds to wait for one scene's video.
MUSE_RENDER_TIMEOUT=600
# Scenes of one project share a Muse conversation; a new one starts after this many.
MUSE_THREAD_SCENE_LIMIT=12
# FFmpeg binary for merging scenes and reading reference frames; found on PATH when unset.
# MUSE_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
